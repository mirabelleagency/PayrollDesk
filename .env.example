# PostgreSQL Database Configuration Template
# Copy this to .env and update with your local values

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
# For local development:
#   - If PostgreSQL is running locally: postgresql://user:password@localhost:5432/dbname
#   - If using Docker: postgresql://user:password@postgres:5432/dbname
PAYROLL_DATABASE_URL=postgresql://payroll_user:payroll_password@localhost:5432/payroll_db

# Application Environment
# Options: development, staging, production
ENVIRONMENT=development

# Session Secret for security
# Generate in production with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# For development, any string works
SECRET_KEY=your-secret-key-here

# Optional: Logging Level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

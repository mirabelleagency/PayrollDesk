{
  // See https://code.visualstudio.com/docs/editor/tasks for documentation
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev PostgreSQL (Docker)",
      "type": "shell",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "command": "docker compose -f docker-compose.dev.yml up -d; Write-Host 'PostgreSQL running on localhost:5432 (payroll/payroll)'",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      }
    },
    {
      "label": "Stop Dev PostgreSQL (Docker)",
      "type": "shell",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "command": "docker compose -f docker-compose.dev.yml down",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      }
    },
    {
      "label": "Run Uvicorn Server (PostgreSQL Dev)",
      "type": "shell",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      },
      "problemMatcher": [],
      "command": "& \"${workspaceFolder}\\.venv\\Scripts\\Activate.ps1\"; uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "ENVIRONMENT": "development",
          "PAYROLL_DATABASE_URL": "postgresql://payroll:payroll@localhost:5432/payroll_dev"
        },
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "dependsOn": "Start Dev PostgreSQL (Docker)"
    }
  ]
}
